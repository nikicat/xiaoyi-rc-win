<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- KitVersion: the SDK and WDK package version, which build.ps1 passes from packages.config -->
    <PackagesDir>$(MSBuildThisFileDirectory)..\packages\</PackagesDir>
    <!-- UMDF_VERSION_MINOR: the version that driver-rs targets, which build.ps1 passes from
         driver-rs/Cargo.toml (ADR 6). Read here, before the WDK props default it to 15. -->
    <UmdfMinorGiven>$(UMDF_VERSION_MINOR)</UmdfMinorGiven>
  </PropertyGroup>
  <Import Project="$(PackagesDir)Microsoft.Windows.SDK.CPP.$(KitVersion)\build\native\Microsoft.Windows.SDK.cpp.props" />
  <Import Project="$(PackagesDir)Microsoft.Windows.SDK.CPP.x64.$(KitVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props" />
  <Import Project="$(PackagesDir)Microsoft.Windows.WDK.x64.$(KitVersion)\build\native\Microsoft.Windows.WDK.x64.props" />
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6E0B2F4C-3A8D-4C1E-9F27-5B1D8A4E7C30}</ProjectGuid>
    <RootNamespace>xiaoyi_rc</RootNamespace>
    <ProjectName>xiaoyi-rc</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <DriverType>UMDF</DriverType>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <UMDF_VERSION_MAJOR>2</UMDF_VERSION_MAJOR>
    <SignMode>Off</SignMode>
    <!-- stampinf dates DriverVer in local time; east of UTC that is "the future" -->
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\build\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\build\obj\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemGroup>
    <Inf Include="xiaoyi-rc.inf" />
  </ItemGroup>
  <!-- RustDll: the driver-rs DLL that build.ps1 builds; this project only packages it -->
  <ItemGroup>
    <FilesToPackage Include="$(RustDll)" />
  </ItemGroup>
  <Target Name="RequireBuildScriptProperties" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(UmdfMinorGiven)' == ''" Text="UMDF_VERSION_MINOR is not set; build with build.ps1, which passes it from driver-rs/Cargo.toml" />
    <Error Condition="'$(RustDll)' == ''" Text="RustDll is not set; build with build.ps1, which builds driver-rs and passes its DLL" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(PackagesDir)Microsoft.Windows.SDK.CPP.$(KitVersion)\build\native\Microsoft.Windows.SDK.cpp.targets" />
</Project>
